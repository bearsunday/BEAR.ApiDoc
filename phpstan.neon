parameters:
  level: max
  paths:
    - src
    - tests
  excludePaths:
    - tests/Fake/*
  ignoreErrors:
    # PHPMD annotations are not PHPStan compatible
    - '#PHPDoc tag @SuppressWarnings has invalid value#'
    # ReflectionClass<T> is invariant in PHP
    - '#ReflectionClass<BEAR\\Resource\\ResourceObject> given#'
    - '#ReflectionClass<BEAR\\ApiDoc\\Fake\\Ro\\FakeParamDoc> given#'
